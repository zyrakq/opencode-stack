REPO_SYNC_URL=
REPO_SYNC_BRANCH=main
REPO_SYNC_DIR_NAME=
# generate one at github.com/settings/personal-access-tokens
REPO_SYNC_TOKEN=ghp-example-token
REPO_SYNC_USER=x-access-token
# generate with: ssh-keygen -t ed25519
REPO_SYNC_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----
REPO_SYNC_INTERVAL=300
REPO_SYNC_IMAGE=alpine/git:latest
