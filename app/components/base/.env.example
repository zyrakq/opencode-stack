COMPOSE_PROJECT_NAME=opencode-stack

IMAGE=ghcr.io/anomalyco/opencode:v2.2.5

LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# Container-internal serve port (entrypoint --port + healthcheck). The
# published host port lives in the forwarding overlay (OPENCODE_PUBLISH_PORT).
# The default 4096 is deliberately distinct from the host systemd
# `opencode serve` bound to 10.144.144.31:8000 — the host service is never
# modified; if 4096 is taken on the host, pick another OPENCODE_PUBLISH_PORT
# in the forwarding overlay instead of touching the host.
OPENCODE_SERVE_PORT=4096
OPENCODE_SERVE_HOSTNAME=0.0.0.0

# Required: server password (basic auth, user "opencode")
OPENCODE_SERVER_PASSWORD=

# Provider model keys (optional passthrough; the Stage A gate seeds auth.json
# into the opencode-stack-data volume instead — secrets never enter the repo)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
