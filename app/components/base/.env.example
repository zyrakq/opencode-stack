COMPOSE_PROJECT_NAME=opencode-stack

IMAGE=ghcr.io/anomalyco/opencode:2.2.5

LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

OPENCODE_SERVE_PORT=4096
OPENCODE_SERVE_HOSTNAME=0.0.0.0

# openssl rand -base64 24
OPENCODE_SERVER_PASSWORD=change-me-strong-password

# cat the key from the provider console
ANTHROPIC_API_KEY=sk-ant-api03-example

# cat the key from the provider console
OPENROUTER_API_KEY=sk-or-v1-example

# cat the key from the provider console
OPENAI_API_KEY=sk-example

PLUGINS=
