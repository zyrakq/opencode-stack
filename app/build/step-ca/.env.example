# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example, repo-sync/.env.example, step-ca-trust/.env.example

COMPOSE_PROJECT_NAME=opencode-stack

IMAGE=ghcr.io/anomalyco/opencode:2.2.5

LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# Container-internal serve port (entrypoint --port + healthcheck). The
# published host port lives in the forwarding overlay (OPENCODE_PUBLISH_PORT).
# The default 4096 is deliberately distinct from the host systemd
# `opencode serve` bound to 10.144.144.31:8000 — the host service is never
# modified; if 4096 is taken on the host, pick another OPENCODE_PUBLISH_PORT
# in the forwarding overlay instead of touching the host.
OPENCODE_SERVE_PORT=4096
OPENCODE_SERVE_HOSTNAME=0.0.0.0

# Required: server password (basic auth, user "opencode")
OPENCODE_SERVER_PASSWORD=

# Provider model keys (optional passthrough; the Stage A gate seeds auth.json
# into the opencode-stack-data volume instead — secrets never enter the repo)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

PLUGINS=
VIRTUAL_PORT=4096
VIRTUAL_HOST=opencode.example.com

VIRTUAL_PROTO=http

LETSENCRYPT_HOST=opencode.example.com

LETSENCRYPT_EMAIL=admin@example.com
# repo-sync extension (mutually exclusive with repo-local)

# Required: repository URL to clone into /projects
REPO_SYNC_URL=

# Branch to track (default: main)
REPO_SYNC_BRANCH=main

# Directory under /projects (default: basename of the URL)
REPO_SYNC_DIR_NAME=

# https credentials (token preferred, read-only; default user: x-access-token)
REPO_SYNC_TOKEN=
REPO_SYNC_USER=x-access-token

# Private key for ssh URLs (optional)
REPO_SYNC_SSH_KEY=

# Seconds between fast-forward pulls (default: 300)
REPO_SYNC_INTERVAL=300

# Sidecar image (default: alpine/git:latest)
REPO_SYNC_IMAGE=alpine/git:latest
# step-ca-trust extension (meaningful only with the step-ca environment;
# requires the external step-ca-data volume)

# Source of the step-ca root CA inside the container (read-only mount of the
# external step-ca-data volume, certs/ subpath)
STEP_CA_ROOT_CA_SRC=/step-ca-root/root_ca.crt

# Install target in the container trust store (copied here, then picked up
# by update-ca-certificates)
STEP_CA_ROOT_CA_FILE=/usr/local/share/ca-certificates/step-ca-root.crt

# Seconds to wait for the root CA to appear before failing (default: 60)
STEP_CA_WAIT_TIMEOUT=60