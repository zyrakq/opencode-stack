# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, letsencrypt/.env.example, repo-sync/.env.example

COMPOSE_PROJECT_NAME=opencode-stack

IMAGE=ghcr.io/anomalyco/opencode:2.2.5

LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

OPENCODE_SERVE_PORT=4096
OPENCODE_SERVE_HOSTNAME=0.0.0.0

# openssl rand -base64 24
OPENCODE_SERVER_PASSWORD=change-me-strong-password

# cat the key from the provider console
ANTHROPIC_API_KEY=sk-ant-api03-example

# cat the key from the provider console
OPENROUTER_API_KEY=sk-or-v1-example

# cat the key from the provider console
OPENAI_API_KEY=sk-example

PLUGINS=
VIRTUAL_PORT=4096
VIRTUAL_HOST=opencode.example.com

VIRTUAL_PROTO=http

LETSENCRYPT_HOST=opencode.example.com

LETSENCRYPT_EMAIL=admin@example.com
REPO_SYNC_URL=
REPO_SYNC_BRANCH=main
REPO_SYNC_DIR_NAME=
# generate one at github.com/settings/personal-access-tokens
REPO_SYNC_TOKEN=ghp-example-token
REPO_SYNC_USER=x-access-token
# generate with: ssh-keygen -t ed25519
REPO_SYNC_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----
REPO_SYNC_INTERVAL=300
REPO_SYNC_IMAGE=alpine/git:latest